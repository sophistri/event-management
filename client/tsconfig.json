{
  "compilerOptions": {
    // File Layout
    // "rootDir": "./src",
    // "outDir": "./dist",


    "module": "es2022",
    "target": "esnext",
    "types": [],
    
    "noUncheckedIndexedAccess": true,

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    
    "strict": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "skipLibCheck": true,


    "allowJs": true,
    "checkJs": false
  },
  "include": ["src"]
}
